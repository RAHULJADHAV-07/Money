# ── Required ─────────────────────────────────────────────────────────────────
# Neon Postgres. Copy this from your Neon project: Dashboard → Connect → the
# *pooled* connection string. The tables are created on first boot.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Signs login tokens. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# ── Google sign-in (optional) ────────────────────────────────────────────────
# The same Client ID the frontend uses. The server needs it to check that an ID
# token was really minted for this app. Without it the Google routes return 503
# and the app falls back to email + password only.
GOOGLE_CLIENT_ID=

# ── Welcome email via Brevo (optional) ───────────────────────────────────────
# Sent once, when someone creates an account. Leave BREVO_API_KEY empty and no
# mail is sent — signup still works exactly the same.
#
# Key: Brevo -> SMTP & API -> API Keys -> Generate a new API key.
# The address in MAIL_FROM must be a *verified sender* in Brevo
# (Senders, Domains & IPs -> Senders), and the account must be phone-verified.
BREVO_API_KEY=
MAIL_FROM=My Hisab <you@example.com>

# Where the links inside the email point.
APP_URL=https://your-app.vercel.app

# ── Production only ──────────────────────────────────────────────────────────
# Which frontend origins may call this API (comma-separated, no trailing slash).
# Leave unset locally; set to your Vercel URL in production.
# CORS_ORIGINS=https://my-hisab.vercel.app
# ALLOW_VERCEL_PREVIEWS=true

# This service's own public URL. Setting it turns on the keep-alive self-ping
# that stops Render's free tier from sleeping. Leave unset locally.
# SELF_URL=https://hisab-api.onrender.com
# KEEPALIVE_MINUTES=10
# KEEPALIVE=off

# How many Postgres connections this instance may hold open.
# PG_POOL_MAX=10

# ── Migration only ───────────────────────────────────────────────────────────
# The old MongoDB Atlas cluster. Needed only by `npm run migrate:mongo`; the app
# itself never reads it, so delete it once the copy is verified.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/hisab
