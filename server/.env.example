# ── Required ─────────────────────────────────────────────────────────────────
# Replace <db_password> with your real Atlas password (URL-encode special chars).
MONGODB_URI=mongodb+srv://Cluster0:<db_password>@cluster0.shect.mongodb.net/hisab?retryWrites=true&w=majority&appName=Cluster0

# Signs login tokens. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# ── Production only ──────────────────────────────────────────────────────────
# Which frontend origins may call this API (comma-separated, no trailing slash).
# Leave unset locally; set to your Vercel URL in production.
# CORS_ORIGINS=https://my-hisab.vercel.app
# ALLOW_VERCEL_PREVIEWS=true

# This service's own public URL. Setting it turns on the keep-alive self-ping
# that stops Render's free tier from sleeping. Leave unset locally.
# SELF_URL=https://hisab-api.onrender.com
# KEEPALIVE_MINUTES=10
# KEEPALIVE=off
