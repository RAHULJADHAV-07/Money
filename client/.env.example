# Where the API lives.
# Leave EMPTY for local dev — Vite proxies /api to localhost:4000.
# In Vercel, set this to your Render URL (no trailing slash).
VITE_API_URL=

# Google sign-in. Paste the *Client ID* from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web application).
# It is public — it ships in the built bundle — so it is safe to commit.
# Leave empty to hide the Google button entirely.
# The server needs the same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
